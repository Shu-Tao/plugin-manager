#!/bin/sh
# 安装后置：修复权限、刷新图标缓存
set -e
JB="/var/jb"
APP="$JB/Applications/PluginManager.app"
HELPER="$JB/usr/libexec/pluginmanager/pmhelper"

if [ -d "$APP" ]; then
    chown -R root:wheel "$APP" 2>/dev/null || true
    chmod 755 "$APP"
    chmod 755 "$APP/PluginManager" 2>/dev/null || true
    find "$APP" -type f -name "*.plist" -exec chmod 644 {} \; 2>/dev/null || true
    find "$APP" -type f -name "*.png" -exec chmod 644 {} \; 2>/dev/null || true
fi

if [ -f "$HELPER" ]; then
    chown root:wheel "$HELPER" 2>/dev/null || true
    chmod 4755 "$HELPER" || true
fi

# 刷新桌面缓存（uicache 存在才调）
if command -v uicache >/dev/null 2>&1; then
    uicache -p "$APP" >/dev/null 2>&1 || true
elif [ -x "$JB/usr/bin/uicache" ]; then
    "$JB/usr/bin/uicache" -p "$APP" >/dev/null 2>&1 || true
fi

exit 0
